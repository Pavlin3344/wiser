# ================================
# PostgreSQL / PostGIS / pgRouting
# ================================
POSTGRES_PASSWORD=

# ================================
# TimescaleDB
# ================================
# Използва същия POSTGRES_PASSWORD

# ================================
# MinIO (S3-compatible storage)
# ================================
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ================================
# RabbitMQ
# ================================
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ================================
# Grafana
# ================================
GRAFANA_PASSWORD=

# ================================
# NASA FIRMS (active fire detections)
# Register at https://firms.modaps.eosdis.nasa.gov/api/area/
# ================================
FIRMS_MAP_KEY=

# ================================
# Copernicus Data Space (Sentinel-2)
# Register at https://dataspace.copernicus.eu/ -> Dashboard -> User Settings -> OAuth clients
# ================================
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ================================
# API authentication
# Shared secret for write endpoints and operator triggers, sent as the X-API-Key
# header. Public read endpoints (the map data the dashboard needs) do not use it.
# Leave empty and every protected endpoint refuses access - it never fails open.
# Generate with: openssl rand -hex 32
# ================================
WISER_API_KEY=

# ================================
# Alert e-mail notifications (optional)
# Alerts are always written to the database; these only control whether a digest
# e-mail also goes out for critical/high severity alerts.
# ================================
ALERTS_NOTIFY_ENABLED=false
ALERTS_NOTIFY_TO=
ALERTS_NOTIFY_FROM=wiser@wisertech.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ================================
# Scheduled OSM import (optional)
# Monthly Overpass import of hospitals/schools. Off by default - the query is heavy
# and this data changes rarely.
# ================================
OSM_IMPORT_SCHEDULED=false

# ================================
# Azure log bridge (infra/docker/azure-log-bridge)
# Чете логовете, които никой процес не праща сам - frontend (nginx), minio, rabbitmq
# и системните събития на Container Apps - и ги подава на Logstash.
#
# Самоличността е отделна и само за четене: "Log Analytics Reader" върху workspace-а
# log-wiser-prod, нищо повече. Не е същата като wiser-github-deploy - той влиза през
# OIDC без парола и не бива да раздава такава на друга машина.
#
# Създава се веднъж (виж infra/docker/azure-log-bridge/README.md) и ако е празно,
# контейнерът излиза с ясна грешка, а останалият стек се вдига непроменен.
# ================================
AZURE_TENANT_ID=
AZURE_LOG_READER_CLIENT_ID=
AZURE_LOG_READER_CLIENT_SECRET=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# Secrets — никога в git. Като ignored, git clean / VS Code "Discard All
# Changes" също не ги трие (без .gitignore запис untracked .env се изтрива!).
.env
.env.*
!.env.example
*.pem

# Terraform state (за Azure миграцията)
*.tfstate
*.tfstate.*
.terraform/
# Реалните стойности носят пароли и Tailscale ключ; .example се комитва.
*.tfvars
!*.tfvars.example

# Python (data/processing workers) — байткодът се генерира при всяко пускане
__pycache__/
*.py[cod]
.pytest_cache/
# Всеки worker си има собствен venv (различни зависимости, rasterio тежи) — локален е.
.venv/

# OS / editor
.DS_Store
Thumbs.db

    {
      "id": 15,
      "type": "timeseries",
      "title": "api: заявки/сек по път (Prometheus)",
      "description": "Actuator-ът на api, без health/prometheus. Втори източник за същото, което ES показва горе.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{job=\"wiser-backend\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{uri}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"

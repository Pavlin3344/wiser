    {
      "id": 1,
      "title": "Рискови зони",
      "description": "Клетки в таблица zones за днешния valid_date. Собственият модел на Wiser: FWI, коригиран с NDVI и горивен тип. Решетката е клипната до очертанието на България, затова числото е под общия брой EFFIS точки.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wiser_data_zones_rows_today",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "orange" },
              { "value": 1500, "color": "green" }
            ]
          },
          "mappings": [{ "type": "value", "options": { "0": { "text": "празно", "color": "red", "index": 0 } } }]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "FWI точки",
      "description": "Точки от EFFIS Fire Weather Index за последния ден. Решетката е 2772 при нормална доставка; рязък спад значи частично сваляне, не по-малък пожарен риск — затова има и аларма FwiGridShrunk под 2000.",
      "type": "stat",
      "gridPos": { "x": 5, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },

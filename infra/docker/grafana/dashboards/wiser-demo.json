    {
      "id": 6,
      "title": "От последните данни",
      "description": "Възрастта на всеки източник, а не дали процесът е жив. Точно това е урокът от zones: таблицата стоя празна седмици, докато всеки контейнер беше зелен. Праговете съвпадат с алармите — FWI 36ч, зони 24ч, NDVI 7д.",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - wiser_data_fwi_last_observation_timestamp_seconds",
          "legendFormat": "Fire Weather Index",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - wiser_data_zones_last_computed_timestamp_seconds",
          "legendFormat": "Рискови зони",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - wiser_data_ndvi_last_product_timestamp_seconds",
          "legendFormat": "NDVI",
          "instant": true,
          "refId": "C"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 259200,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 86400, "color": "yellow" },
              { "value": 129600, "color": "orange" },
              { "value": 604800, "color": "red" }
